      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "!49  .  N/072  .  W-"
    },
    {
      "id": "position/compressed-course-speed",
      "description": "Compressed position with course and speed in the cs bytes, compression type from RMC.",
      "source": "APRS12c ch. 9",
      "authority": "spec",
      "input": {"info": "=/5L!!<*e7>7P["},
      "expect": {
        "data": {"type": "position", "messaging": true, "latitude": 49.5, "longitude": -72.75000393777269, "symbol": "/>", "compressed": true, "compression": {"fix": "current", "source": "rmc", "origin": "software"}, "course_degrees": 88, "speed_knots": 36.23201216883807}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "position/weather",
