{
  "cases": [
    {
      "id": "position/no-timestamp-with-comment",
      "description": "A plain position report: no timestamp, no messaging, comment after the symbol.",
      "source": "APRS12c ch. 8",
      "authority": "spec",
      "input": {"info": "!4903.50N/07201.75W-Test 001234"},
      "expect": {
        "data": {"type": "position", "latitude": 49.05833333333333, "longitude": -72.02916666666667, "symbol": "/-", "comment": "Test 001234"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "position/timestamp-messaging-course-speed",
      "description": "Local-time timestamp, messaging capable, course and speed extension.",
      "source": "APRS12c ch. 8",
      "authority": "spec",
      "input": {"info": "@092345/4903.50N/07201.75W>088/036"},
      "expect": {
        "data": {"type": "position", "timestamp": "092345/", "messaging": true, "latitude": 49.05833333333333, "longitude": -72.02916666666667, "symbol": "/>", "course_degrees": 88, "speed_knots": 36}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "position/phg",
      "description": "PHG extension straight after the symbol.",
      "source": "APRS12c ch. 8",
      "authority": "spec",
      "input": {"info": "=4903.50N/07201.75W#PHG5132"},
      "expect": {
        "data": {"type": "position", "messaging": true, "latitude": 49.05833333333333, "longitude": -72.02916666666667, "symbol": "/#", "phg": {"power": 5, "height": 1, "gain": 3, "directivity": 2}}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "position/ambiguity-4",
      "description": "Position ambiguity to the nearest degree; the decoded point is the centre of that degree.",
      "source": "APRS12c ch. 6",
      "authority": "interpretation",
