      "reencode": "identical"
    },
    {
      "id": "position/lowercase-hemisphere",
      "description": "Lower-case hemisphere letters: a strict decoder rejects them, a lenient one reads them as upper case.",
      "source": "UAP 5.9",
      "authority": "spec",
      "input": {"tnc2": "N1EOE>APN391,N1NCI-3*,WIDE2-1:!4216.95n/07243.20w#phg6230/ Easthampton MA"},
      "expect": {
        "data": {"type": "position", "latitude": 42.2825, "longitude": -72.72, "symbol": "/#", "comment": "phg6230/ Easthampton MA"},
        "diagnostics": ["warning:lowercase-hemisphere", "warning:lowercase-hemisphere"]
      },
      "strict": {"rejected_by": "lowercase-hemisphere"},
      "reencode": "equivalent",
      "canonical_info": "!4216.95N/07243.20W#phg6230/ Easthampton MA"
    },
    {
      "id": "position/phg-after-comment-text",
      "description": "PHG after other comment text: a lenient decoder lifts it out, a strict one leaves it as text (an interpretation, not a rejection).",
      "source": "UAP 5.15",
      "authority": "interpretation",
      "interpretations": ["delimiters-at-the-start-of-free-text"],
      "input": {"tnc2": "UNCAN>APOT30:!4258.99N/07135.29W# 10.8V 98F PHG37306/ N1PA-Mt Uncanoonuc Digi"},
      "expect": {
        "data": {"type": "position", "latitude": 42.98316666666667, "longitude": -71.58816666666667, "symbol": "/#", "phg": {"power": 3, "height": 7, "gain": 3, "directivity": 0, "beacons_per_hour": 6}, "comment": "10.8V 98F  N1PA-Mt Uncanoonuc Digi"},
        "diagnostics": ["warning:data-extension-in-comment"]
      },
      "strict": {"data": {"type": "position", "latitude": 42.98316666666667, "longitude": -71.58816666666667, "symbol": "/#", "comment": "10.8V 98F PHG37306/ N1PA-Mt Uncanoonuc Digi"}},
      "reencode": "equivalent",
      "canonical_info": "!4258.99N/07135.29W#PHG37306/10.8V 98F  N1PA-Mt Uncanoonuc Digi"
    },
    {
      "id": "position/frequency-later-in-comment",
      "description": "A frequency after PHG and a space is comment text, not a voice frequency, and is written back where it was.",
      "source": "APRS-IS 2026-09-26",
      "authority": "observed",
      "input": {"tnc2": "SQ9MDD-4>APBOX0,TCPIP*,qAC,T2WARSPL:=5215.02N/02055.60E-PHG2201 /145.575MHz lub SR5WZ"},
      "expect": {
        "data": {"type": "position", "messaging": true, "latitude": 52.25033333333333, "longitude": 20.926666666666666, "symbol": "/-", "phg": {"power": 2, "height": 2, "gain": 0, "directivity": 1}, "comment": "/145.575MHz lub SR5WZ"}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "=5215.02N/02055.60E-PHG2201//145.575MHz lub SR5WZ"
    },
