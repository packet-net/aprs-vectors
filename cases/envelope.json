{
  "cases": [
    {
      "id": "envelope/digipeated-path",
      "description": "A TNC2 header whose path has been digipeated twice.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": "WB2OSZ>APDW18,N2GH,W2UB*,WIDE2-1:>hello"},
      "expect": {
        "header": {"source": "WB2OSZ", "destination": "APDW18", "path": ["N2GH*", "W2UB*", "WIDE2-1"]},
        "data": {"type": "status", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/q-construct",
      "description": "An APRS-IS header with a q-construct naming the IGate.",
      "source": "APRS-IS",
      "authority": "spec",
      "input": {"tnc2": "N0CALL-9>APZ001,WIDE1-1,qAR,M0LTE-10:>hello"},
      "expect": {
        "header": {"source": "N0CALL-9", "destination": "APZ001", "path": ["WIDE1-1", "qAR", "M0LTE-10"], "q_construct": {"construct": "qAR", "station": "M0LTE-10"}},
        "data": {"type": "status", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
