{
  "cases": [
    {
      "id": "differential/q-construct-lower-case",
      "description": "A q-construct's third letter may be lower case: the APRS-IS q-construct algorithm defines qAr and qAo beside qAR and qAO, all four for packets an IGate heard on RF. Packet.Aprs read them; aprs-rs missed them on 13,000 packets.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
      "input": {"tnc2": "JA1KWV-11>APTT4,WIDE1-1,WIDE2-1,qAr,JA1KWV-1:>test with TT4+ADS-WS1"},
      "expect": {
        "header": {"source": "JA1KWV-11", "destination": "APTT4", "path": ["WIDE1-1", "WIDE2-1", "qAr", "JA1KWV-1"], "q_construct": {"construct": "qAr", "station": "JA1KWV-1"}},
        "data": {"type": "status", "text": "test with TT4+ADS-WS1"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "differential/telemetry-sequence-past-999",
      "description": "A telemetry sequence number of five digits, with decimal and empty analog values. Any length of letters and digits is a sequence; aprs-rs took more than three characters for a defect on 13,000 packets.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["telemetry-sequence-numbers-are-not-3-characters"],
      "input": {"tnc2": "BH2WAV-7>APRS2,WIDE1-1,TCPIP*,qAS,BH2WAV:T#51752,108.0,230.0,100,385,,10000000"},
      "expect": {
        "header": {"source": "BH2WAV-7", "destination": "APRS2", "path": ["WIDE1-1*", "TCPIP*", "qAS", "BH2WAV"], "q_construct": {"construct": "qAS", "station": "BH2WAV"}},
        "data": {"type": "telemetry", "sequence": "51752", "analog": [108.0, 230.0, 100, 385, null], "bits": "10000000"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "differential/telemetry-trailing-empty-value",
      "description": "Telemetry values end at a comma or the end of the field, so a trailing comma leaves one more empty (null) value: 132, null, null. Too few values, and no bits, is a tolerated invalid-telemetry.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
      "input": {"tnc2": "VE7MHW-5>APZ131,TCPIP*,qAS,VE7MHW:T#173,132,,"},
      "expect": {
        "header": {"source": "VE7MHW-5", "destination": "APZ131", "path": ["TCPIP*", "qAS", "VE7MHW"], "q_construct": {"construct": "qAS", "station": "VE7MHW"}},
        "data": {"type": "telemetry", "sequence": "173", "analog": [132, null, null]},
        "diagnostics": ["warning:invalid-telemetry"]
      },
      "strict": {"rejected_by": "invalid-telemetry"},
      "reencode": "refused"
    },
    {
      "id": "differential/telemetry-sequence-with-a-space",
      "description": "A telemetry sequence that is not letters and digits (190 187): not a telemetry report, an invalid-telemetry error rather than a tolerated defect.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["telemetry-sequence-numbers-are-not-3-characters"],
      "input": {"tnc2": "OK0DJ-1>APMI06,OK0BR-1*,WIDE2-1,qAR,OK0BPT-1:T#190 187,097,028,065,000,00000000"},
      "expect": {
        "header": {"source": "OK0DJ-1", "destination": "APMI06", "path": ["OK0BR-1*", "WIDE2-1", "qAR", "OK0BPT-1"], "q_construct": {"construct": "qAR", "station": "OK0BPT-1"}},
        "data": {"type": "unrecognized", "reason": "malformed"},
        "diagnostics": ["error:invalid-telemetry"]
      },
      "strict": "same"
    },
    {
      "id": "differential/telemetry-sequence-empty",
      "description": "T#, then a comma straight away: an empty sequence, so not a telemetry report (invalid-telemetry, an error).",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["telemetry-sequence-numbers-are-not-3-characters"],
      "input": {"tnc2": "NTRL>APMTCP,qAR,AE7AF:T#,175,015,002,094,000,00000000"},
      "expect": {
        "header": {"source": "NTRL", "destination": "APMTCP", "path": ["qAR", "AE7AF"], "q_construct": {"construct": "qAR", "station": "AE7AF"}},
        "data": {"type": "unrecognized", "reason": "malformed"},
        "diagnostics": ["error:invalid-telemetry"]
      },
      "strict": "same"
    },
    {
      "id": "differential/telemetry-sequence-without-comma",
      "description": "T#1890000: no comma ends the sequence, so not a telemetry report (invalid-telemetry, an error).",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["telemetry-sequence-numbers-are-not-3-characters"],
      "input": {"tnc2": "BVILLE>APOAR,K0X,qAR,AE7AF:T#1890000"},
      "expect": {
        "header": {"source": "BVILLE", "destination": "APOAR", "path": ["K0X", "qAR", "AE7AF"], "q_construct": {"construct": "qAR", "station": "AE7AF"}},
        "data": {"type": "unrecognized", "reason": "malformed"},
        "diagnostics": ["error:invalid-telemetry"]
      },
      "strict": "same"
    },
    {
      "id": "differential/frequency-tone-burst",
      "description": "A repeater object whose voice frequency has a 1750 Hz tone burst and a range in km: 1750 R27k (APRS12c ch. 18). aprs-rs did not know the tone burst and left the fields in the comment.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "spec",
      "input": {"tnc2": "DB0OX>APRS,TCPIP*,qAC,T2LAUSITZ:;ER-DB0OX *111111z5335.43NE00711.51E0438.700MHz 1750 R27k SvxLink DB0OX OV Norden I09"},
      "expect": {
        "header": {"source": "DB0OX", "destination": "APRS", "path": ["TCPIP*", "qAC", "T2LAUSITZ"], "q_construct": {"construct": "qAC", "station": "T2LAUSITZ"}},
        "data": {"type": "object", "name": "ER-DB0OX", "timestamp": "111111z", "latitude": 53.5905, "longitude": 7.191833333333333, "symbol": "E0", "frequency": {"mhz": 438.7, "tone": "tone-burst", "range": 27, "range_km": true}, "comment": "SvxLink DB0OX OV Norden I09"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "differential/frequency-tone-burst-narrow",
      "description": "l750 (lower-case L) is the 1750 Hz tone burst, narrow (APRS12c ch. 18), here after PHG and a / delimiter, with an offset and a range.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "spec",
      "input": {"tnc2": "DB0LHR>APSVX1,TCPIP*,qAC,T2CSNGRAD:;EL-DB0LHR*111111z4820.91N/00751.73ErPHG3260/439.400MHz l750 -076 R15k SvxLink by SM0SVX"},
      "expect": {
        "header": {"source": "DB0LHR", "destination": "APSVX1", "path": ["TCPIP*", "qAC", "T2CSNGRAD"], "q_construct": {"construct": "qAC", "station": "T2CSNGRAD"}},
        "data": {"type": "object", "name": "EL-DB0LHR", "timestamp": "111111z", "latitude": 48.3485, "longitude": 7.862166666666667, "symbol": "/r", "phg": {"power": 3, "height": 2, "gain": 6, "directivity": 0}, "frequency": {"mhz": 439.4, "tone": "tone-burst", "offset_khz": -760, "range": 15, "range_km": true, "narrow": true}, "comment": "SvxLink by SM0SVX"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "differential/mic-e-text-after-frequency",
      "description": "After a voice frequency and its fields, one space is dropped, then (once everything else is lifted out) one leading delimiter; the rest of the spaces stay in the comment. aprs-rs skipped all of them.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["delimiters-at-the-start-of-free-text"],
      "input": {"tnc2": "VK3ZAZ-15>S7T3V8,WIDE1-1,WIDE2-1,qAR,VK3RMV-1:`FY)l \u001C-/`438.487MHz Toff -700                 Western Districts_%"},
      "expect": {
        "header": {"source": "VK3ZAZ-15", "destination": "S7T3V8", "path": ["WIDE1-1", "WIDE2-1", "qAR", "VK3RMV-1"], "q_construct": {"construct": "qAR", "station": "VK3RMV-1"}},
        "data": {"type": "mic-e", "mic_e_message": "in-service", "type_code": "`", "device_suffix": "_%", "latitude": -37.728, "longitude": 142.01883333333333, "symbol": "/-", "speed_knots": 0, "frequency": {"mhz": 438.487, "tone": "off", "offset_khz": -7000}, "comment": "               Western Districts"},
        "device": {"vendor": "Yaesu", "model": "FTM-400DR"}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "`FY)l \u001C-/`438.487MHz Toff -700 /               Western Districts_%"
    },
    {
      "id": "differential/text-after-frequency-and-altitude",
      "description": "The /A= altitude is lifted out before a voice frequency is looked for at the start, so /144.800MHz/A=002169 gives both; one space after the frequency and one leading delimiter are dropped, and / QTH: IN80dj stays.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["delimiters-at-the-start-of-free-text"],
      "input": {"tnc2": "EA4HQQ-7>APDR16,TCPIP*,qAC,T2SWEDEN:=4023.77N/00340.02W[075/000/144.800MHz/A=002169  / QTH: IN80dj"},
      "expect": {
        "header": {"source": "EA4HQQ-7", "destination": "APDR16", "path": ["TCPIP*", "qAC", "T2SWEDEN"], "q_construct": {"construct": "qAC", "station": "T2SWEDEN"}},
        "data": {"type": "position", "messaging": true, "latitude": 40.396166666666666, "longitude": -3.667, "symbol": "/[", "course_degrees": 75, "speed_knots": 0, "altitude_feet": 2169, "frequency": {"mhz": 144.8}, "comment": "/ QTH: IN80dj"}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "=4023.77N/00340.02W[075/000/A=002169144.800MHz // QTH: IN80dj"
    },
    {
      "id": "differential/eqns-trailing-commas",
      "description": "EQNS. with only the first three channels' coefficients and a run of empty entries after them: the list stops there (\"the list may stop at any field\", APRS12c ch. 13). aprs-rs took it for a malformed list and a plain message.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "spec",
      "input": {"tnc2": "ED1ZAD-3>APMI01,TCPIP*,qAC,T2SPAIN::ED1ZAD-3 :EQNS.0,10,0,0,10,0,0,1,0,,,,,,"},
      "expect": {
        "header": {"source": "ED1ZAD-3", "destination": "APMI01", "path": ["TCPIP*", "qAC", "T2SPAIN"], "q_construct": {"construct": "qAC", "station": "T2SPAIN"}},
        "data": {"type": "telemetry-coefficients", "addressee": "ED1ZAD-3", "coefficients": [0, 10, 0, 0, 10, 0, 0, 1, 0]}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": ":ED1ZAD-3 :EQNS.0,10,0,0,10,0,0,1,0"
    },
    {
      "id": "differential/eqns-trailing-spaces",
      "description": "EQNS. whose last coefficient is followed by spaces: they are padding, and the list stops (APRS12c ch. 13).",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "spec",
      "input": {"tnc2": "TB1YZC-13>APRS,TCPIP*,qAC,T2SYDNEY::TB1YZC-13:EQNS.0,1,0,0,1,0,0,1,-150,0,0    "},
      "expect": {
        "header": {"source": "TB1YZC-13", "destination": "APRS", "path": ["TCPIP*", "qAC", "T2SYDNEY"], "q_construct": {"construct": "qAC", "station": "T2SYDNEY"}},
        "data": {"type": "telemetry-coefficients", "addressee": "TB1YZC-13", "coefficients": [0, 1, 0, 0, 1, 0, 0, 1, -150, 0, 0]}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": ":TB1YZC-13:EQNS.0,1,0,0,1,0,0,1,-150,0,0"
    },
    {
      "id": "differential/metadata-message-id",
      "description": "PARM. sent as a numbered message keeps its message_id, as every other message does. aprs-rs dropped it.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
      "input": {"tnc2": "VA7RCV-15>APZMDM,WIDE1-1,WIDE2-2,qAO,VA7RCV-10::VA7RCV-15:PARM.Battery,Temp,Pressure,Humidity,Altitude{625"},
      "expect": {
        "header": {"source": "VA7RCV-15", "destination": "APZMDM", "path": ["WIDE1-1", "WIDE2-2", "qAO", "VA7RCV-10"], "q_construct": {"construct": "qAO", "station": "VA7RCV-10"}},
        "data": {"type": "telemetry-names", "addressee": "VA7RCV-15", "names": ["Battery", "Temp", "Pressure", "Humidity", "Altitude"], "message_id": "625"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "differential/weather-extra-field-then-more-fields",
      "description": "An uncompressed weather report with c/s wind fields, then X01, a letter the spec does not define with two digits: an extra field, after which the fields go on (L010 is luminosity).",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
      "input": {"tnc2": "KG4JYA-11>APDW18,TCPIP*,qAC,T2QUEBEC:!3947.92N/07509.75W_c002s008g010t072r000p000P000h44b01005X01L010"},
      "expect": {
        "header": {"source": "KG4JYA-11", "destination": "APDW18", "path": ["TCPIP*", "qAC", "T2QUEBEC"], "q_construct": {"construct": "qAC", "station": "T2QUEBEC"}},
        "data": {"type": "position", "latitude": 39.79866666666667, "longitude": -75.1625, "symbol": "/_", "weather": {"wind_direction_degrees": 2, "wind_speed_mph": 8, "wind_gust_mph": 10, "temperature_f": 72, "rain_1h_in": 0, "rain_24h_in": 0, "rain_midnight_in": 0, "humidity_percent": 44, "pressure_mbar": 100.5, "luminosity_w_m2": 10, "extra": [{"letter": "X", "value": "01"}]}},
        "diagnostics": ["warning:wind-fields-instead-of-extension"]
      },
      "strict": {"rejected_by": "wind-fields-instead-of-extension"},
      "reencode": "equivalent",
      "canonical_info": "!3947.92N/07509.75W_002/008g010t072r000p000P000h44b01005L010X01"
    },
    {
      "id": "differential/weather-extra-field-negative",
      "description": "v-01 at the end of a weather report: an extra field (a letter the spec does not define, then digits, dots or - ending in a digit), which an encoder writes back as it came.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
      "input": {"tnc2": "IK3SVW-3>APEWX,WIDE2-3,qAR,IR3EO-11:!4540.62N/01212.52E_000/000g000t057r000b10200h70v-01"},
      "expect": {
        "header": {"source": "IK3SVW-3", "destination": "APEWX", "path": ["WIDE2-3", "qAR", "IR3EO-11"], "q_construct": {"construct": "qAR", "station": "IR3EO-11"}},
        "data": {"type": "position", "latitude": 45.677, "longitude": 12.208666666666666, "symbol": "/_", "weather": {"wind_direction_degrees": 0, "wind_speed_mph": 0, "wind_gust_mph": 0, "temperature_f": 57, "rain_1h_in": 0, "humidity_percent": 70, "pressure_mbar": 1020, "extra": [{"letter": "v", "value": "-01"}]}}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "!4540.62N/01212.52E_000/000g000t057r000h70b10200v-01"
    },
    {
      "id": "differential/weather-letter-and-digits-at-the-end",
      "description": "v31 at the end of a weather report is an extra field, not a software type and unit: a unit is not all digits.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
