    {
      "id": "differential/wind-extension-replaces-cs",
      "description": "A compressed weather position whose cs bytes read 156 degrees at 1.15 mph, then 156/001: the extension is the wind, at its full precision.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "interpretation",
      "interpretations": ["wind-after-a-compressed-weather-position"],
      "input": {"tnc2": "NW6UP>APJYC1,WIDE1-1,qAO,KI6ZHD-6:@212049h/;Y6h/\\'(_H*C156/001g002t000r000p000P000h00b00000 SunnyvaleCA/IC-T7H+GP/DStar=xlx.nw6up.com"},
