        "data": {"type": "position", "messaging": true, "latitude": 7.649166666666667, "longitude": -80.41116666666667, "symbol": "/_", "weather": {}, "comment": "s00/g000t075r000p000h99b.....*27 WX_Canajagua 15.1V"},
