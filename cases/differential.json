    {
      "id": "differential/weather-repeated-field-ends-fields",
      "description": "A positionless weather report ending t2k: t was already read, so the fields end there, and t2k is the software type and unit.",
      "source": "APRS-IS 2026-09-25/26",
      "authority": "observed",
