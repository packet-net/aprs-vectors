    {
      "id": "corpus-finding/aprsdroid-tone-and-offset-after-an-altitude",
      "description": "APRSdroid writes the altitude straight after the frequency and the user's tone and offset after it: the /A= does not cut them off, so they are the frequency's.",
      "source": "APRS-IS 2026-10-01",
      "authority": "observed",
      "interpretations": ["lifting-an-element-never-joins-the-text-either-side-of-it"],
      "input": {"tnc2": "K7PIA-9>APDR16,WIDE1-1,WIDE2-1,qAR,VCAPK:=4701.42N/12254.21W>240/059/146.820MHz/A=-00016 T103 -060 73!"},
      "expect": {
        "header": {"source": "K7PIA-9", "destination": "APDR16", "path": ["WIDE1-1", "WIDE2-1", "qAR", "VCAPK"], "q_construct": {"construct": "qAR", "station": "VCAPK"}},
        "data": {"type": "position", "latitude": 47.02366666666667, "longitude": -122.9035, "symbol": "/>", "course_degrees": 240, "speed_knots": 59, "altitude_feet": -16, "frequency": {"mhz": 146.82, "tone": "tone", "tone_value": 103, "offset_khz": -600}, "comment": "73!", "messaging": true}
      },
      "strict": "same",
      "reencode": "equivalent",
      "canonical_info": "=4701.42N/12254.21W>240/059/146.820MHz T103 -060/A=-00016 73!"
    },
