    },
    {
      "id": "message/nts-radiogram-lines-are-ordinary-message-text",
      "description": "Nts radiogram lines are ordinary message text.",
      "source": "APRS12c ch. 14",
      "authority": "spec",
      "input": {"info": ":W1AW     :N1\\line 1 of NTS message text{12"},
      "expect": {
        "data": {"type": "message", "addressee": "W1AW", "text": "N1\\line 1 of NTS message text", "message_id": "12"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/general-query-with-footprint-uses-a-space-for-positive",
      "description": "General query with footprint uses a space for positive.",
      "source": "APRS12c ch. 15",
      "authority": "spec",
      "input": {"info": "?APRS? 34.02,-117.15,0200"},
      "expect": {
        "data": {"type": "query", "query_type": "APRS", "footprint": {"latitude": 34.02, "longitude": -117.15, "radius_miles": 200}}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/nws-bulletin-id-is-for-reference-only",
      "description": "Nws bulletin id is for reference only.",
      "source": "APRS12c ch. 14",
      "authority": "spec",
      "input": {"info": ":NWS-WARN :092010z,THUNDER_STORM,AR_ASHLEY,{S9JbA"},
      "expect": {
        "data": {"type": "nws-bulletin", "addressee": "NWS-WARN", "text": "092010z,THUNDER_STORM,AR_ASHLEY,", "message_id": "S9JbA"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/email-message",
      "description": "Email message.",
      "source": "APRS12c ch. 14",
      "authority": "spec",
      "input": {"info": ":EMAIL    :msproul@ap.org Test email"},
      "expect": {
        "data": {"type": "message", "addressee": "EMAIL", "text": "msproul@ap.org Test email"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/nws-bulletin-underscore",
      "description": "An NWS bulletin addressed NWS_ rather than NWS-, the form aprs-is.net gives for compressed NWS bulletins.",
      "source": "aprs-is.net/wx",
      "authority": "interpretation",
      "interpretations": ["nws-bulletins-are-addressed-nws--or-nws_"],
      "input": {"info": ":NWS_ADVIS:092010z,WIND,AR_ASHLEY"},
      "expect": {
        "data": {"type": "nws-bulletin", "addressee": "NWS_ADVIS", "text": "092010z,WIND,AR_ASHLEY"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/nws-without-a-separator-is-a-message",
      "description": "An addressee that starts NWS with no - or _ after it is an ordinary message, not an NWS bulletin.",
      "source": "APRS12c ch. 14",
      "authority": "interpretation",
      "interpretations": ["nws-bulletins-are-addressed-nws--or-nws_"],
      "input": {"info": ":NWSBOT   :hello"},
      "expect": {
        "data": {"type": "message", "addressee": "NWSBOT", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/last-brace-starts-the-id",
      "description": "The message ID starts at the last { followed by 1-5 letters or digits; an earlier { is brace-in-message-text, and the ID is still read.",
      "source": "APRS12c ch. 14",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::N0CALL-7 :a{b{12"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "N0CALL-7", "text": "a{b", "message_id": "12"},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "telemetry-metadata/eqns-with-no-coefficients",
      "description": "EQNS. with only commas carries no coefficients: a plain message with invalid-telemetry-metadata.",
      "source": "APRS12c ch. 13",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::N0CALL-7 :EQNS.,,,"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "N0CALL-7", "text": "EQNS.,,,"},
        "diagnostics": ["info:invalid-telemetry-metadata"]
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/nws-bulletin-brace-in-text",
      "description": "An NWS bulletin whose { does not start a message ID keeps it in the text (brace-in-message-text, tolerated); an encoder does not write it back.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::NWS-WARN :092010z,THUNDER_STORM{AR_ASHLEY"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "nws-bulletin", "addressee": "NWS-WARN", "text": "092010z,THUNDER_STORM{AR_ASHLEY"},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "telemetry-metadata/brace-in-project-title",
      "description": "A { in a bit-sense project title that does not start a message ID stays in the title (brace-in-message-text, tolerated); an encoder does not write it back.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["a-brace-in-telemetry-metadata"],
      "input": {"tnc2": "N0CALL>APZ001::N0QBF-11 :BITS.10110000,N0QBF{s Big Balloon"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "telemetry-bits", "addressee": "N0QBF-11", "bits": "10110000", "project": "N0QBF{s Big Balloon"},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "message/nws-bulletin-longer-than-67",
      "description": "An NWS bulletin has no length limit (APRS12c ch. 14), so 78 characters of text re-encode as sent.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::NWS-WARN :092010z,THUNDER_STORM,AR_ASHLEY,AR_CHICOT,AR_DESHA,AR_DREW,AR_UNION,AR_BRADLEY{S9JbA"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "nws-bulletin", "addressee": "NWS-WARN", "text": "092010z,THUNDER_STORM,AR_ASHLEY,AR_CHICOT,AR_DESHA,AR_DREW,AR_UNION,AR_BRADLEY", "message_id": "S9JbA"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "telemetry-metadata/brace-in-a-unit",
      "description": "A { inside a UNIT. list that does not start a message ID stays in the unit: still telemetry metadata, with brace-in-message-text (tolerated).",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["a-brace-in-telemetry-metadata"],
      "input": {"tnc2": "N0CALL>APZ001::N0QBF-11 :UNIT.v/100,deg{F,deg.F"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "telemetry-units", "addressee": "N0QBF-11", "units": ["v/100", "deg{F", "deg.F"]},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "message/addressee-starting-with-colon",
      "description": "A 9-character addressee field followed by : is read as the addressee even when it starts with : (invalid-addressee-characters, tolerated); the empty-addressee rule is only for a : found before the tenth byte.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001:::YO8RXT-5:salut{180"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": ":YO8RXT-5", "text": "salut", "message_id": "180"},
        "diagnostics": ["warning:invalid-addressee-characters"]
      },
      "strict": {"rejected_by": "invalid-addressee-characters"},
      "reencode": "refused"
    },
    {
      "id": "message/ack-then-not-a-message-id",
      "description": "ack1348 followed by {420505, which is too long for a message ID: not an ack but a message with a stray { (brace-in-message-text, tolerated).",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::KD4DRA-10:ack1348{420505"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "KD4DRA-10", "text": "ack1348{420505"},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "message/bln-then-lower-case-is-a-message",
      "description": "BLN and a lower-case letter is not a bulletin or announcement identifier (a digit or an upper-case letter), so this is an ordinary message.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::BLNe     :Burn in testing"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "BLNe", "text": "Burn in testing"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/bln-then-punctuation-is-a-message",
      "description": "BLN- is not a bulletin addressee: the character after BLN is a digit or an upper-case letter.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>APZ001::BLN-     :WX report"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "BLN-", "text": "WX report"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/bulletin-with-reply-ack-form",
      "description": "A bulletin is not acknowledged, so it takes a message ID but not the reply-ack form: {12} is not an ID and stays in the text (brace-in-message-text, tolerated).",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["reply-acks-are-for-messages"],
      "input": {"tnc2": "N0CALL>APZ001::BLN1     :Snow expected{12}"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "bulletin", "addressee": "BLN1", "text": "Snow expected{12}"},
        "diagnostics": ["warning:brace-in-message-text"]
      },
      "strict": {"rejected_by": "brace-in-message-text"},
      "reencode": "refused"
    },
    {
      "id": "message/query-type-with-digits",
      "description": "?APRS000: a query type is upper-case letters, and APRS followed straight by 000 is not a type the spec defines followed by a space or the end, so this is an ordinary message.",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["query-types-are-upper-case-letters"],
      "input": {"tnc2": "N0CALL>APZ001::KH2Z     :?APRS000"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "KH2Z", "text": "?APRS000"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "message/query-target-not-a-callsign",
      "description": "?APRST~: the text after the query type is not a callsign (1-9 letters, digits or -), so this is a message (invalid-query info).",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["a-directed-querys-target-is-one-callsign"],
      "input": {"tnc2": "N0CALL>APZ001::KH2Z     :?APRST~"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "KH2Z", "text": "?APRST~"},
        "diagnostics": ["info:invalid-query"]
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "telemetry-metadata/plus-sign-in-a-coefficient",
      "description": "A coefficient is written as a telemetry value is, with at most a minus sign; +5.2 is not one, so EQNS. is a plain message (invalid-telemetry-metadata info).",
      "source": "differential fuzzing 2026-09-27",
      "authority": "interpretation",
      "interpretations": ["numbers-in-telemetry"],
      "input": {"tnc2": "N0CALL>APZ001::N0QBF-11 :EQNS.0,+5.2,0"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "APZ001"},
        "data": {"type": "message", "addressee": "N0QBF-11", "text": "EQNS.0,+5.2,0"},
        "diagnostics": ["info:invalid-telemetry-metadata"]
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "telemetry-metadata/carriage-return-by-a-coefficient",
