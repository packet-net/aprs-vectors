      "id": "message/message-without-id-expects-no-ack",
      "description": "Message without id expects no ack.",
      "source": "APRS12c ch. 14",
      "authority": "spec",
      "input": {"info": ":WU2Z     :Testing"},
      "expect": {
        "data": {"type": "message", "addressee": "WU2Z", "text": "Testing"}
      },
