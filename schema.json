          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "object",
                    "required": [
                      "utc"
                    ],
                    "additionalProperties": false,
