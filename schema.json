                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "wind_direction_degrees": {
                    "type": "number"
                  },
                  "wind_speed_mph": {
                    "type": "number"
                  },
                  "wind_gust_mph": {
                    "type": "number"
                  },
                  "temperature_f": {
                    "type": "number"
                  },
                  "temperature_c": {
                    "type": "number"
                  },
                  "rain_1h_in": {
                    "type": "number"
                  },
                  "rain_24h_in": {
                    "type": "number"
                  },
                  "rain_midnight_in": {
                    "type": "number"
                  },
                  "rain_1h_mm": {
                    "type": "number"
                  },
                  "rain_24h_mm": {
                    "type": "number"
                  },
                  "rain_midnight_mm": {
                    "type": "number"
                  },
                  "humidity_percent": {
                    "type": "number"
                  },
                  "pressure_mbar": {
                    "type": "number"
                  },
                  "luminosity_w_m2": {
                    "type": "number"
                  },
                  "snow_24h_in": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "message"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "addressee": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "message_id": {
                    "type": "string"
                  },
                  "reply_ack": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "ack"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "addressee": {
                    "type": "string"
                  },
                  "message_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "reject"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "addressee": {
                    "type": "string"
                  },
                  "message_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
