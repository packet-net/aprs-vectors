          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "timestamp": {
                    "type": "object",
                    "required": [
                      "utc"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "utc": {
                        "type": "string"
                      },
                      "format": {
                        "enum": [
                          "dhm",
