{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/packet-net/aprs-vectors/blob/main/schema.json",
  "title": "APRS conformance vector file",
  "description": "A file of cases in spec/aprs/cases. See spec/aprs/README.md for what each key means and how to compare results.",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "string",
      "pattern": "^(info|warning|error):[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "data": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "position",
            "mic-e",
            "object",
            "item",
            "message",
            "ack",
            "reject",
            "bulletin",
            "nws-bulletin",
            "telemetry-names",
            "telemetry-units",
            "telemetry-coefficients",
            "telemetry-bits",
            "directed-query",
            "status",
            "telemetry",
            "weather",
            "raw-weather",
            "nmea",
            "maidenhead-beacon",
            "query",
            "capabilities",
            "third-party",
            "user-defined",
            "test",
            "agrelo-df",
            "unrecognized"
          ]
        }
      }
    },
    "header": {
      "type": "object",
      "required": [
        "source",
        "destination"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "q_construct": {
          "type": "object",
          "required": [
            "construct"
          ],
          "additionalProperties": false,
          "properties": {
            "construct": {
              "type": "string"
            },
            "station": {
              "type": "string"
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "description",
        "source",
        "authority",
        "input",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "authority": {
          "enum": [
            "spec",
            "interpretation",
            "observed"
          ]
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tnc2": {
              "type": "string"
            },
            "tnc2_hex": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{2})*$"
            },
            "ax25_hex": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{2})*$"
            },
            "info": {
              "type": "string"
            },
            "info_hex": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{2})*$"
            },
            "encode": {
              "$ref": "#/$defs/data"
            },
            "build": {
              "$ref": "#/$defs/build"
            },
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "tnc2"
              ]
            },
            {
              "required": [
                "tnc2_hex"
              ]
            },
            {
              "required": [
                "ax25_hex"
              ]
            },
            {
              "required": [
                "info"
              ]
            },
            {
              "required": [
                "info_hex"
              ]
            },
            {
              "required": [
                "encode"
              ]
            },
            {
              "required": [
                "build"
              ]
            }
          ]
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/data"
            },
            "diagnostics": {
              "$ref": "#/$defs/diagnostics"
            },
            "header": {
              "$ref": "#/$defs/header"
            },
            "header_error": {
              "$ref": "#/$defs/diagnostics"
            },
            "device": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "vendor": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              }
            },
            "info": {
              "type": "string"
            },
            "tnc2": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            },
            "refused": {
              "const": true
            },
            "refusal": {
              "$ref": "#/$defs/code"
            }
          },
          "if": {
            "required": [
              "refusal"
            ]
          },
          "then": {
            "required": [
              "refused"
            ]
          }
        },
        "strict": {
          "oneOf": [
            {
              "const": "same"
            },
            {
              "type": "object",
              "required": [
                "rejected_by"
              ],
              "additionalProperties": false,
              "properties": {
                "rejected_by": {
                  "$ref": "#/$defs/code"
                },
                "header": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "data"
              ],
              "additionalProperties": false,
              "properties": {
                "data": {
                  "$ref": "#/$defs/data"
                },
                "diagnostics": {
                  "$ref": "#/$defs/diagnostics"
                }
              }
            }
          ]
        },
        "reencode": {
          "enum": [
            "identical",
            "equivalent",
            "rounded",
            "refused"
          ]
        },
        "canonical_info": {
          "type": "string"
        },
        "reencode_refusal": {
          "$ref": "#/$defs/code"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reencode_refusal"
            ]
          },
          "then": {
            "required": [
              "reencode"
            ],
            "properties": {
              "reencode": {
                "const": "refused"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "required": [
                  "encode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expect": {
                "propertyNames": {
                  "enum": [
                    "info",
                    "destination",
                    "refused",
                    "refusal"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "required": [
                  "build"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expect": {
                "propertyNames": {
                  "enum": [
                    "tnc2",
                    "refused",
                    "refusal"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "encode"
                      ]
                    },
                    {
                      "required": [
                        "build"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "expect": {
                "propertyNames": {
                  "enum": [
                    "data",
                    "diagnostics",
                    "header",
                    "header_error",
                    "device"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "required": [
        "report",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "station": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "report": {
          "enum": [
            "position",
            "object",
            "item",
            "mic-e",
            "weather",
            "message",
            "ack",
            "reject",
            "bulletin",
            "status",
            "telemetry",
            "telemetry-names",
            "telemetry-units",
            "telemetry-coefficients",
            "telemetry-bits"
          ]
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "report": {
                "const": "position"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "messaging": {
                    "type": "boolean"
                  },
                  "timestamp": {
                    "type": "object",
                    "required": [
                      "utc"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "utc": {
                        "type": "string"
                      },
                      "format": {
                        "enum": [
                          "dhm",
                          "hms",
                          "mdhm"
                        ]
                      }
                    }
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "course_degrees": {
                    "type": "number"
                  },
                  "speed_knots": {
                    "type": "number"
                  },
                  "speed_kmh": {
                    "type": "number"
                  },
                  "altitude_feet": {
                    "type": "number"
                  },
                  "altitude_m": {
                    "type": "number"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "phg": {
                    "type": "object"
                  },
                  "range_miles": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "object"
                  },
                  "compressed": {
                    "type": "boolean"
                  },
                  "ambiguity": {
                    "type": "number"
                  },
                  "dao": {
                    "type": "boolean"
                  },
                  "telemetry": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "timestamp": {
                    "type": "object",
                    "required": [
                      "utc"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "utc": {
                        "type": "string"
                      },
                      "format": {
                        "enum": [
                          "dhm",
                          "hms",
                          "mdhm"
                        ]
                      }
                    }
                  },
                  "killed": {
                    "type": "boolean"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "course_degrees": {
                    "type": "number"
                  },
                  "speed_knots": {
                    "type": "number"
                  },
                  "speed_kmh": {
                    "type": "number"
                  },
                  "altitude_feet": {
                    "type": "number"
                  },
                  "altitude_m": {
                    "type": "number"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "phg": {
                    "type": "object"
                  },
                  "range_miles": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "object"
                  },
                  "compressed": {
                    "type": "boolean"
                  },
                  "ambiguity": {
                    "type": "number"
                  },
                  "dao": {
                    "type": "boolean"
                  },
                  "telemetry": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "item"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "killed": {
                    "type": "boolean"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "course_degrees": {
                    "type": "number"
                  },
                  "speed_knots": {
                    "type": "number"
                  },
                  "speed_kmh": {
                    "type": "number"
                  },
                  "altitude_feet": {
                    "type": "number"
                  },
                  "altitude_m": {
                    "type": "number"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "phg": {
                    "type": "object"
                  },
                  "range_miles": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "object"
                  },
                  "compressed": {
                    "type": "boolean"
                  },
                  "ambiguity": {
                    "type": "number"
                  },
                  "dao": {
                    "type": "boolean"
                  },
                  "telemetry": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "mic-e"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "mic_e_message": {
                    "enum": [
                      "off-duty",
                      "en-route",
                      "in-service",
                      "returning",
                      "committed",
                      "special",
                      "priority",
                      "custom0",
                      "custom1",
                      "custom2",
                      "custom3",
                      "custom4",
                      "custom5",
                      "custom6",
                      "emergency"
                    ]
                  },
                  "messaging": {
                    "type": "boolean"
                  },
                  "type_code": {
                    "type": "string"
                  },
                  "device_suffix": {
                    "type": "string"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "course_degrees": {
                    "type": "number"
                  },
                  "speed_knots": {
                    "type": "number"
                  },
                  "speed_kmh": {
                    "type": "number"
                  },
                  "altitude_feet": {
                    "type": "number"
                  },
                  "altitude_m": {
                    "type": "number"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "phg": {
                    "type": "object"
                  },
                  "range_miles": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "object"
                  },
                  "compressed": {
                    "type": "boolean"
                  },
                  "ambiguity": {
                    "type": "number"
                  },
                  "dao": {
                    "type": "boolean"
                  },
                  "telemetry": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report": {
                "const": "weather"
